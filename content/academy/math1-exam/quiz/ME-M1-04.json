  "questions": [
    {
      "id": "q1",
      "type": "mc",
      "prompt": "$(x+3)^2$ として正しいものはどれか。",
      "choices": [
        "$x^2+6x+9$",
        "$x^2+9$",
        "$x^2+3x+9$",
        "$x^2+6x+6$"
