      "answer": "$x^2+6x+9$",
      "explain": "真ん中 $2ab=6x$ を落とさない。"
    },
    {
      "id": "q2",
      "type": "short",
      "prompt": "$(2x-1)^2$ を展開せよ。",
      "answer": "$4x^2-4x+1$",
      "explain": "$(2x)^2=4x^2$、$-2\\cdot 2x\\cdot 1=-4x$。"
    },
    {
      "id": "q3",
      "type": "short",
      "prompt": "$(3x+1)(3x-1)$ を展開せよ。",
      "answer": "$9x^2-1$",
      "explain": "平方の差 $a^2-b^2$。"
    },
    {
      "id": "q4",
      "type": "short",
      "prompt": "$(x+2)^2-(x-2)^2$ を簡単にせよ。",
      "answer": "$8x$",
      "explain": "展開しても $A^2-B^2$ でも $8x$。"
    },
    {
      "id": "q5",
      "type": "short",
      "prompt": "$(2x)^2$ を計算せよ。よくある誤りも一文で。",
      "answer": "$4x^2$（$2x^2$ と書くのが誤り）",
      "explain": "係数にも二乗がかかる。"
    }
