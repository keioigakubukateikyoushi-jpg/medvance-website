# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# image originals (backed up locally, not needed in repo)
/_backup_images

# local dev/prod server logs and scratch output
dev-server*.log
prod-server-*.log
output/
.next-dev.log
.codex-screenshots/
.claude/
*.bak

.env*

# Academy: 大容量バイナリはリポジトリに載せない（PDFは /api/academy/pdf で生成）
# lesson.html / manifest.json / 軽量アセットのみコミット対象
public/academy/media/**/*.mp4
public/academy/media/**/*.m4a
public/academy/media/**/*.mov
public/academy/media/**/lesson.pdf
public/academy/media/**/slides.pdf
public/academy/media/**/nlm_*.pdf
public/academy/media/**/nlm_*.m4a
public/academy/media/**/nlm_*.mp4
public/academy/media/**/*_frames/**
public/academy/media/**/audio*.m4a
public/academy/media/**/video*.mp4
public/academy/media/**/*.pptx
public/academy/media/**/_alignment_lock.txt
public/academy/media/**/nlm_quiz.json
public/academy/media/**/quiz.json

# 無料サンプル配信ファイルのみ例外（Vercel CLI は .gitignore も除外するため必須）
# 対象: audio / video / slides / quiz の配信名のみ。nlm_* は引き続き除外。
!public/academy/media/ME-M1-01/audio.m4a
!public/academy/media/ME-M1-01/video.mp4
!public/academy/media/ME-M1-01/slides.pdf
