# Vercel CLI respects BOTH .gitignore and .vercelignore.
# Free-sample delivery files are allowlisted in .gitignore.
# Here: keep local tooling out, and drop non-free / junk media only.

# Local / tooling
node_modules
.next
.git
*.log
output
_backup_images
.env*
content/academy/nlm-queue.json

# Drop non-delivery junk under media (all units)
public/academy/media/**/*_frames/**
public/academy/media/**/nlm_*
public/academy/media/**/_alignment_lock.txt
public/academy/media/**/_video_director.md
public/academy/media/**/lesson.pdf
public/academy/media/**/*.pptx

# Paid / non-free unit binaries stay gitignored; no extra rules needed.
# Free unit delivery names (audio.m4a / video.mp4 / slides.pdf / quiz.json)
# are un-ignored in .gitignore and must be uploaded.
