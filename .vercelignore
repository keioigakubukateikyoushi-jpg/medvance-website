# Vercel CLI uploads the working tree (including gitignored files).
# Keep serverless functions under the 250MB limit.

# Academy heavy binaries (PDF is generated by /api/academy/pdf)
public/academy/media/**/*.pdf
public/academy/media/**/*.mp4
public/academy/media/**/*.m4a
public/academy/media/**/*.mov
public/academy/media/**/*.pptx
public/academy/media/**/*_frames/**
public/academy/media/**/nlm_*

# Local / tooling
node_modules
.next
.git
*.log
output
_backup_images
.env*
content/academy/nlm-queue.json
